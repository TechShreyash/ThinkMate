# Keep the build context (and image) lean and free of secrets.

# Secrets / local env — config is injected via environment variables.
.env
.env.*
*.env

# Virtual envs & Python caches
.venv/
venv/
__pycache__/
*.py[oc]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
wheels/
*.egg-info/

# VCS & tooling
.git/
.gitignore
.python-version

# Project meta not needed at runtime
.kiro/
.agents/
docs/
tests/
README.md
changelog.md

# Runtime output & local data
logs/
data/
